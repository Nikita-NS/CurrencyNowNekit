# Токен от @BotFather
BOT_TOKEN=123456789:AAE-your-token-here

# PostgreSQL. Локально: postgresql://fxbot:fxbot@localhost:5432/fxbot
# В docker-compose переопределяется на db:5432 автоматически.
DATABASE_URL=postgresql://fxbot:fxbot@localhost:5432/fxbot

# yahoo — реальные курсы без ключа, demo — генератор (для проверки интерфейса)
RATES_PROVIDER=yahoo

# Часовой пояс графиков
TZ_NAME=Europe/Moscow

# Как часто снимать курсы, секунды (минимум 20)
POLL_INTERVAL=60

# Как присылать график:
#   photo    — картинкой в чат (удобно смотреть, но Telegram пережимает в JPEG)
#   document — файлом без сжатия (качество 1:1)
# В любом режиме кнопка «Без сжатия» присылает PNG 2560x1440 документом.
SEND_AS=photo

# Кому доступна команда /stats (через запятую). Пусто — всем.
ADMIN_IDS=

# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
